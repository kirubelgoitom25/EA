{
  "expo": {
    "name": "EA",
    "slug": "EA",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.studentapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B1A38",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.anonymous.studentapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      "expo-font",
      "expo-asset"
    ]
  }
}
